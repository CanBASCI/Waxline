    "onboarding_five" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Five scores 1. A full six scores 2."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Beşli 1 puan, altılı 2 puan."
          }
        }
      }
    },
    "onboarding_five_detail" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Five seals in a straight line win the hand for 1 point — across, down, or diagonal. The line can start on one tablet and finish on the next. A full row of six is worth 2. If both of you make five on the same turn, it is a draw."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Yatay, dikey veya çapraz beş mühür 1 puandır. Çizgi bir tablette başlayıp yanındakinde bitebilir. Tahtayı boydan boya altı mühür 2 puandır. Aynı turda ikiniz de beşli yaparsa el berabere biter."
          }
        }
      }
    },
    "onboarding_invite" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "The player who invites opens first."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Davet eden ilk eli açar."
          }
        }
      }
    },
    "onboarding_invite_detail" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "In a friend match, whoever sent the invite plays red and places the first seal. After Play Again, the other player opens the next hand. Colors stay the same for the whole session."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Arkadaş maçında daveti gönderen kırmızı oynar ve ilk taşı basar. Yeniden oyna dendiğinde bir sonraki eli diğeri açar. Renkler o oturumda değişmez."
          }
        }
      }
    },
    "onboarding_next" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Next"
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "İleri"
          }
        }
      }
    },
    "onboarding_place" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Place a seal on any empty cell."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Boş bir hücreye mühür bas."
          }
        }
      }
    },
    "onboarding_place_detail" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Each turn begins with one seal. Red and blue take turns. You cannot press a cell that already has a seal."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Her el bir mühürle başlar. Kırmızı ve mavi sırayla oynar. Dolu hücreye basılmaz."
          }
        }
      }
    },
    "onboarding_quadrant" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "After you place, swipe one tablet."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Mühürden sonra bir tableti kaydır."
          }
        }
      }
    },
    "onboarding_quadrant_detail" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "The board is four small 3×3 tablets. Your turn has two steps: press a seal, then swipe the tablet you want to move."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tahta dört küçük 3×3 tablettir. Elin iki adımı var: önce mühür bas, sonra hareket ettirmek istediğin tableti kaydır."
          }
        }
      }
    },
    "onboarding_rotate" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "That swipe turns it 90 degrees."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kaydırınca tablet 90 derece döner."
          }
        }
      }
    },
    "onboarding_rotate_detail" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Swipe right or left: the tablet turns a quarter circle, nothing more. Then it is the other player’s turn."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sağa veya sola kaydır: tablet bir çeyrek daire döner, daha fazla değil. Sonra sıra rakipte."
          }
        }
      }
    },
    "onboarding_skip" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Skip"
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
