{
  "sourceLanguage" : "en",
  "strings" : {
    "–" : {
      "comment" : "A dash used to separate the counts of your and your opponent's scores in a series.",
      "isCommentAutoGenerated" : true
    },
    "%lld" : {
      "comment" : "A timer displayed in the game HUD, showing the remaining time for the current player's turn. The text inside the timer is the number of seconds remaining, capped at 1.",
      "isCommentAutoGenerated" : true
    },
    "%lld, %lld" : {
      "comment" : "A string that announces the number of remaining seals for each player in the format \"red: 3, indigo: 2\".",
      "isCommentAutoGenerated" : true,
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "%1$lld, %2$lld"
          }
        }
      }
    },
