{
  "sourceLanguage" : "en",
  "strings" : {
    "–" : {
      "comment" : "A dash used to separate the counts of your team and the opponent's team in a series score row.",
      "isCommentAutoGenerated" : true
    },
    "%lld" : {
      "comment" : "A timer displaying the remaining time for a player's turn. The value inside the parentheses is the number of seconds remaining for the player's turn.",
      "isCommentAutoGenerated" : true
    },
    "%lld, %lld" : {
      "comment" : "A string describing the number of seals remaining for each player. The first argument is the count of remaining seals for the red player. The second argument is the count of remaining seals for the indigo player.",
      "isCommentAutoGenerated" : true,
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "%1$lld, %2$lld"
