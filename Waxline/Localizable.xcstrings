{
  "sourceLanguage" : "en",
  "strings" : {
    "–" : {
      "comment" : "A dash used to separate the counts of your and your opponent's scores in a series.",
      "isCommentAutoGenerated" : true
    },
    "%lld" : {
      "comment" : "A timer displaying the remaining time for a player's turn. The value is always between 1 and 60.",
      "isCommentAutoGenerated" : true
    },
    "%lld, %lld" : {
      "comment" : "A string that announces the number of remaining seals for each player in the format \"Red: 3, Indigo: 5\".",
      "isCommentAutoGenerated" : true,
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "%1$lld, %2$lld"
          }
        }
      }
    },
    "+%lld" : {
      "comment" : "A label displaying the number of points earned by a user. The argument is the number of points.",
      "isCommentAutoGenerated" : true
    },
