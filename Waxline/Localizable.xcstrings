          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Siguiente"
          }
        }
      }
    },
    "onboarding_place": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Place a seal on any empty cell."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Boş bir hücreye mühür bas."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Setze ein Siegel auf ein leeres Feld."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "空いているマスに印を置く。"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Coloca un sello en una casilla vacía."
          }
        }
      }
    },
    "onboarding_place_detail": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Each turn begins with one seal. Red and blue take turns. You cannot press a cell that already has a seal."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Her el bir mühürle başlar. Kırmızı ve mavi sırayla oynar. Dolu hücreye basılmaz."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Jede Runde beginnt mit einem Siegel. Rot und Blau sind abwechselnd dran. Ein belegtes Feld kannst du nicht wählen."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "各手番は印を1つ置くところから始まる。赤と青が交互に打つ。すでに印があるマスには置けない。"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Cada turno empieza con un sello. Rojo y azul se alternan. No puedes pulsar una casilla que ya tenga sello."
          }
        }
      }
    },
    "onboarding_quadrant": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "After you place, swipe one tablet."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Mühürden sonra bir tableti kaydır."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Nach dem Setzen eine Platte wischen."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "置いたら、タイルを1つスワイプする。"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Después de colocar, desliza una tableta."
          }
        }
      }
    },
    "onboarding_quadrant_detail": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The board is four small 3×3 tablets. Your turn has two steps: press a seal, then swipe the tablet you want to move."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Tahta dört küçük 3×3 tablettir. Elin iki adımı var: önce mühür bas, sonra hareket ettirmek istediğin tableti kaydır."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Das Brett besteht aus vier kleinen 3×3-Platten. Dein Zug hat zwei Schritte: erst ein Siegel setzen, dann die Platte wischen, die du drehen willst."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "盤は3×3の小さなタイルが4枚。手番は2段階：まず印を置き、動かしたいタイルをスワイプする。"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "El tablero son cuatro tabletas pequeñas de 3×3. Tu turno tiene dos pasos: coloca un sello y luego desliza la tableta que quieras mover."
          }
        }
      }
    },
    "onboarding_rotate": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "That swipe turns it 90 degrees."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Kaydırınca tablet 90 derece döner."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Diese Wischbewegung dreht sie um 90 Grad."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "スワイプで90度回る。"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Ese deslizamiento la gira 90 grados."
          }
        }
      }
    },
    "onboarding_rotate_detail": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Swipe right or left: the tablet turns a quarter circle, nothing more. Then it is the other player’s turn."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Sağa veya sola kaydır: tablet bir çeyrek daire döner, daha fazla değil. Sonra sıra rakipte."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Nach rechts oder links wischen: Die Platte dreht sich um ein Viertel, nicht weiter. Dann ist der andere dran."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "右か左にスワイプすると、タイルは直角に1回だけ回る。それで相手の番になる。"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Desliza a la derecha o a la izquierda: la tableta gira un cuarto de vuelta, nada más. Luego le toca al otro."
          }
        }
      }
    },
