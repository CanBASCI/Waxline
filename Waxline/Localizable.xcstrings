    "onboarding_five": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Five scores 1. A full six scores 2."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Beşli 1 puan, altılı 2 puan."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Fünf zählen 1. Ein volles Sechs zählt 2."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "5つで1点。6つそろえば2点。"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Cinco valen 1. Seis completos valen 2."
          }
        }
      }
    },
    "onboarding_five_detail": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Five seals in a straight line win the hand for 1 point — across, down, or diagonal. The line can start on one tablet and finish on the next. A full row of six is worth 2. If both of you make five on the same turn, it is a draw."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Yatay, dikey veya çapraz beş mühür 1 puandır. Çizgi bir tablette başlayıp yanındakinde bitebilir. Tahtayı boydan boya altı mühür 2 puandır. Aynı turda ikiniz de beşli yaparsa el berabere biter."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Fünf Siegel in einer geraden Linie gewinnen die Runde für 1 Punkt — waagerecht, senkrecht oder diagonal. Die Linie kann auf einer Platte beginnen und auf der nächsten enden. Eine volle Reihe aus sechs zählt 2. Machen beide im selben Zug fünf, ist es unentschieden."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "縦・横・斜めに印が5つ並ぶと1点。線は1枚のタイルから隣のタイルへまたいでよい。6つ一直線なら2点。同じ手番で両方が5つ揃えたら引き分け。"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Cinco sellos en línea recta ganan la mano por 1 punto: horizontal, vertical o diagonal. La línea puede empezar en una tableta y terminar en la siguiente. Una fila completa de seis vale 2. Si ambos hacen cinco en el mismo turno, es empate."
          }
        }
      }
    },
    "onboarding_invite": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The player who invites opens first."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Davet eden ilk eli açar."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Wer einlädt, eröffnet die erste Runde."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "招待した側が先手。"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Quien invita abre la primera mano."
          }
        }
      }
    },
    "onboarding_invite_detail": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "In a friend match, whoever sent the invite plays red and places the first seal. After Play Again, the other player opens the next hand. Colors stay the same for the whole session."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Arkadaş maçında daveti gönderen kırmızı oynar ve ilk taşı basar. Yeniden oyna dendiğinde bir sonraki eli diğeri açar. Renkler o oturumda değişmez."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Im Freundschaftsspiel spielt, wer die Einladung geschickt hat, Rot und setzt das erste Siegel. Nach „Nochmal spielen“ eröffnet der andere die nächste Runde. Die Farben bleiben die ganze Sitzung gleich."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "友達対戦では、招待を送った人が赤で最初の印を置く。「もう一度」のあと、次の局は相手が先手。色はその対局のあいだ変わらない。"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "En una partida con amigos, quien envió la invitación juega de rojo y coloca el primer sello. Tras Jugar de nuevo, el otro abre la siguiente mano. Los colores no cambian en toda la sesión."
          }
        }
      }
    },
    "onboarding_next": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Next"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "İleri"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Weiter"
          }
        },
        "ja": {
